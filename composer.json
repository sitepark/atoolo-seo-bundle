{
    "name": "atoolo/seo-bundle",
    "description": "Symfony bundle for SEO",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "veltrup",
            "email": "veltrup@sitepark.com"
        }
    ],
    "require": {
        "php": ">=8.1 <8.6.0",
        "ext-xmlwriter": "*",
        "atoolo/resource-bundle": "dev-feature/id-based-resource-location",
        "atoolo/index-bundle": "dev-feature/id-based-resource-location",
        "atoolo/search-bundle": "dev-feature/id-based-resource-location",
        "atoolo/rewrite-bundle": "dev-feature/id-based-resource-location",
        "symfony/config": "^6.3 || ^7.4.17",
        "symfony/dependency-injection": "^6.3 || ^7.4.17",
        "symfony/framework-bundle": "^6.3 || ^7.4.19",
        "symfony/http-kernel": "^6.3 || ^7.4.19",
        "symfony/yaml": "^6.3 || ^7.4.18",
        "ext-intl": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "infection/infection": "^0.27.11",
        "overtrue/phplint": "^9.7.2",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "phpunit/phpunit": "^10.5.64",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.13.6"
    },
    "repositories": {},
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Atoolo\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoolo\\Seo\\Test\\": "test/"
        }
    },
    "archive": {
        "exclude": [
            "/*",
            "/.*",
            "!/composer.json",
            "!/config",
            "!/src"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "post-install-cmd": "phive --no-progress install --force-accept-unsigned --trust-gpg-keys C00543248C87FB13,4AA394086372C20A,51C67305FFC2E5C0,E82B2FB314E9906E",
        "analyse:phplint": "./vendor/bin/phplint",
        "analyse:phpstan": "./tools/phpstan analyse",
        "analyse:phpcsfixer": "./tools/php-cs-fixer check --diff --show-progress=dots",
        "analyse:compatibilitycheck": "./vendor/bin/phpcs --standard=./phpcs.compatibilitycheck.xml",
        "analyse": [
            "@analyse:phplint",
            "@analyse:phpstan",
            "@analyse:phpcsfixer",
            "@analyse:compatibilitycheck"
        ],
        "fix:phpcsfixer": "./tools/php-cs-fixer fix",
        "fix": [
            "@fix:phpcsfixer"
        ],
        "report:phpstan": "./tools/phpstan analyse --no-progress --no-ansi --no-interaction --error-format=checkstyle > ./var/log/phpstan-report.xml || exit 0",
        "report": [
            "@report:phpstan"
        ],
        "test:phpunit": "./tools/phpunit.phar -c phpunit.xml --coverage-text",
        "test:infection": "vendor/bin/infection --threads=8 --no-progress --only-covered -s || exit 0",
        "test": [
            "@test:phpunit"
        ]
    }
}
